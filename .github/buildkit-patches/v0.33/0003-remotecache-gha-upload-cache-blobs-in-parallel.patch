From ec8a3bb60021bb268e6edede31d1ab1b84895f9c Mon Sep 17 00:00:00 2001
From: Cyril Rohr <hey@cyrilrohr.com>
Date: Tue, 29 Sep 2026 09:06:15 +0200
Subject: [PATCH 3/4] remotecache/gha: upload cache blobs in parallel

Finalize checked and uploaded every layer blob one at a time. With many
layers, or large ones, the export spends most of its time on sequential
cache API round trips. Check and upload blobs in parallel, bounded like
registry cache pushes by the default registry concurrency. A blob backs
one layer per parent chain it appears in, so each blob is uploaded once:
concurrent uploads of the same key would race each other. The cache
config is unchanged: layer annotations are still set in order.

Signed-off-by: Cyril Rohr <hey@cyrilrohr.com>
---
 cache/remotecache/gha/gha.go | 73 ++++++++++++++++++++++--------------
 1 file changed, 44 insertions(+), 29 deletions(-)

diff --git a/cache/remotecache/gha/gha.go b/cache/remotecache/gha/gha.go
index afc7a08de..ae0145123 100644
--- a/cache/remotecache/gha/gha.go
+++ b/cache/remotecache/gha/gha.go
@@ -25,6 +25,7 @@ import (
 	"github.com/moby/buildkit/util/bklog"
 	"github.com/moby/buildkit/util/compression"
 	"github.com/moby/buildkit/util/progress"
+	"github.com/moby/buildkit/util/resolver/limited"
 	"github.com/moby/buildkit/util/tracing"
 	bkversion "github.com/moby/buildkit/version"
 	"github.com/moby/buildkit/worker"
@@ -219,6 +220,31 @@ func indexKey(scope string, config *Config) string {
 	return key
 }
 
+// uploadBlob saves a layer blob unless the cache already has it. Without the
+// active key map, existence is checked with a lookup.
+func (ce *exporter) uploadBlob(ctx context.Context, key string, blob digest.Digest, dgstPair v1.DescriptorProviderPair) error {
+	if ce.keyMap == nil {
+		b, err := ce.cache.Load(ctx, key)
+		if err != nil {
+			return err
+		}
+		if b != nil {
+			return nil
+		}
+	}
+	layerDone := progress.OneOff(ctx, fmt.Sprintf("writing layer %s", blob))
+	ra, err := dgstPair.Provider.ReaderAt(ctx, dgstPair.Descriptor)
+	if err != nil {
+		return layerDone(err)
+	}
+	if err := ce.cache.Save(ctx, key, ra); err != nil {
+		if !errors.Is(err, os.ErrExist) {
+			return layerDone(errors.Wrap(err, "error writing layer blob"))
+		}
+	}
+	return layerDone(nil)
+}
