From: Cyril Rohr <hey@cyrilrohr.com>
Date: Tue, 29 Sep 2026 12:18:25 +0200
Subject: [PATCH 6/7] remotecache/gha: upload cache blobs in parallel

Finalize checked and uploaded every layer blob one at a time, so with
many layers, or large ones, the export spends most of its time on
sequential cache API round trips.

Annotate every layer first, then check and upload the distinct blobs in
parallel, bounded like registry cache pushes by the default registry
concurrency. An invalid layer still fails the export before any upload
starts, and the cache config is unchanged. A blob backs one layer per
parent chain it appears in, so it is uploaded once: uploading the same
key twice at once would race.

Signed-off-by: Cyril Rohr <hey@cyrilrohr.com>
---
 cache/remotecache/gha/gha.go | 83 ++++++++++++++++++++++--------------
 1 file changed, 52 insertions(+), 31 deletions(-)

diff --git a/cache/remotecache/gha/gha.go b/cache/remotecache/gha/gha.go
index ca3b43a3c..bbdc20522 100644
--- a/cache/remotecache/gha/gha.go
+++ b/cache/remotecache/gha/gha.go
@@ -25,6 +25,7 @@ import (
 	"github.com/moby/buildkit/util/bklog"
 	"github.com/moby/buildkit/util/compression"
 	"github.com/moby/buildkit/util/progress"
+	"github.com/moby/buildkit/util/resolver/limited"
 	"github.com/moby/buildkit/util/tracing"
 	bkversion "github.com/moby/buildkit/version"
 	"github.com/moby/buildkit/worker"
@@ -222,6 +223,36 @@ func indexKey(scope string, config *Config) string {
 	return key
 }
 
+// uploadBlob saves a layer blob unless the cache already has it.
+func (ce *exporter) uploadBlob(ctx context.Context, dgstPair v1.DescriptorProviderPair) error {
+	ce.initActiveKeyMap(ctx)
+	key := blobKey(dgstPair.Descriptor.Digest)
+	if ce.keyMap != nil {
+		if _, ok := ce.keyMap[key]; ok {
+			return nil
+		}
+	} else {
+		b, err := ce.cache.Load(ctx, key)
+		if err != nil {
+			return err
+		}
+		if b != nil {
+			return nil
+		}
+	}
+	layerDone := progress.OneOff(ctx, fmt.Sprintf("writing layer %s", dgstPair.Descriptor.Digest))
+	ra, err := dgstPair.Provider.ReaderAt(ctx, dgstPair.Descriptor)
+	if err != nil {
+		return layerDone(err)
+	}
+	if err := ce.cache.Save(ctx, key, ra); err != nil {
+		if !errors.Is(err, os.ErrExist) {
+			return layerDone(errors.Wrap(err, "error writing layer blob"))
+		}
+	}
+	return layerDone(nil)
+}
+
 func (ce *exporter) initActiveKeyMap(ctx context.Context) {
 	ce.keyMapOnce.Do(func() {
 		if ce.config.Repository == "" || ce.config.GHToken == "" {
@@ -258,7 +289,11 @@ func (ce *exporter) Finalize(ctx context.Context) (_ map[string]string, err erro
 		return nil, err
 	}
 
-	// TODO: push parallel
+	// Annotate every layer before uploading anything, so that an invalid layer
+	// fails the export before any upload starts. A blob backs one layer per
+	// parent chain it appears in and is uploaded once.
+	var blobs []v1.DescriptorProviderPair
+	seen := map[digest.Digest]struct{}{}
 	for i, l := range config.Layers {
 		dgstPair, ok := descs[l.Blob]
 		if !ok {
@@ -277,36 +312,9 @@ func (ce *exporter) Finalize(ctx context.Context) (_ map[string]string, err erro
 			return nil, errors.Wrapf(err, "failed to parse uncompressed annotation")
 		}
 		diffID = dgst
-		ce.initActiveKeyMap(ctx)
-
-		key := blobKey(dgstPair.Descriptor.Digest)
-
-		exists := false
-		if ce.keyMap != nil {
-			if _, ok := ce.keyMap[key]; ok {
-				exists = true
-			}
-		} else {
-			b, err := ce.cache.Load(ctx, key)
-			if err != nil {
-				return nil, err
-			}
-			if b != nil {
-				exists = true
-			}
-		}
-		if !exists {
-			layerDone := progress.OneOff(ctx, fmt.Sprintf("writing layer %s", l.Blob))
-			ra, err := dgstPair.Provider.ReaderAt(ctx, dgstPair.Descriptor)
-			if err != nil {
-				return nil, layerDone(err)
-			}
-			if err := ce.cache.Save(ctx, key, ra); err != nil {
-				if !errors.Is(err, os.ErrExist) {
-					return nil, layerDone(errors.Wrap(err, "error writing layer blob"))
-				}
-			}
-			layerDone(nil)
+		if _, ok := seen[l.Blob]; !ok {
+			seen[l.Blob] = struct{}{}
+			blobs = append(blobs, dgstPair)
 		}
 		la := &cacheimporttypes.LayerAnnotations{
 			DiffID:    diffID,
@@ -323,6 +331,19 @@ func (ce *exporter) Finalize(ctx context.Context) (_ map[string]string, err erro
 		config.Layers[i].Annotations = la
 	}
 
+	// Check and upload the blobs in parallel, bounded like registry cache
+	// pushes: one at a time, each takes a cache API round trip or more.
+	eg, egCtx := errgroup.WithContext(ctx)
+	eg.SetLimit(int(limited.Default.Size()))
+	for _, dgstPair := range blobs {
+		eg.Go(func() error {
+			return ce.uploadBlob(egCtx, dgstPair)
+		})
+	}
+	if err := eg.Wait(); err != nil {
+		return nil, err
+	}
+
 	dt, err := json.Marshal(config)
 	if err != nil {
 		return nil, err
