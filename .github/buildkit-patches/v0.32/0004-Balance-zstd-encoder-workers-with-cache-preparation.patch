From 55537606db1ca8d9f10217ba4d3e8696b3775d82 Mon Sep 17 00:00:00 2001
From: Cyril Rohr <hey@cyrilrohr.com>
Date: Fri, 31 Jul 2026 23:36:49 +0200
Subject: [PATCH 4/5] Balance zstd encoder workers with cache preparation

---
 util/compression/zstd.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/util/compression/zstd.go b/util/compression/zstd.go
index 9237811e0..af29d27eb 100644
--- a/util/compression/zstd.go
+++ b/util/compression/zstd.go
@@ -12,7 +12,7 @@ import (
 
 func (c zstdType) Compress(ctx context.Context, comp Config) (compressorFunc Compressor, finalize Finalizer) {
 	return func(dest io.Writer, _ string) (io.WriteCloser, error) {
-		var opts []zstd.EOption
+		opts := []zstd.EOption{zstd.WithEncoderConcurrency(2)}
 		if comp.Level != nil {
 			opts = append(opts, zstd.WithEncoderLevel(zstd.EncoderLevelFromZstd(*comp.Level)))
 		}
